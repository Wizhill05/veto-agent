# ==========================================
# Veto Agent Environment Configuration
# ==========================================

# Mode: 'mock' (offline demo / no Auth0 credentials required) or 'auth0' (live Auth0 + real GitHub)
MODE=mock

# ------------------------------------------
# Auth0 Configuration (Required when MODE=auth0)
# ------------------------------------------
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=your_auth0_client_id
AUTH0_CLIENT_SECRET=your_auth0_client_secret
AUTH0_AUDIENCE=https://your-tenant.us.auth0.com/api/v2/

# CIBA Target User Identifier (email or user_id for bc-authorize)
CIBA_USER_EMAIL=admin@example.com
# Optional: user_id directly if preferred over login_hint
# CIBA_USER_ID=auth0|123456789

# CIBA Polling Settings
CIBA_POLL_INTERVAL_SECONDS=2
CIBA_TIMEOUT_SECONDS=60

# ------------------------------------------
# Auth0 Token Vault Configuration
# ------------------------------------------
# Connection name in Auth0 for GitHub social connection (default: 'github')
AUTH0_TOKEN_VAULT_CONNECTION=github
# Auth0 user ID whose vaulted third-party GitHub token is being retrieved
AUTH0_USER_ID=oauth2|github|12345678

# ------------------------------------------
# GitHub Service Configuration
# ------------------------------------------
# Optional default repository for commands (owner/repo)
GITHUB_DEFAULT_REPO=octocat/Hello-World

# Fallback direct GitHub token for mock/hybrid testing (if not using Token Vault)
# GITHUB_TOKEN=ghp_exampleToken

# ------------------------------------------
# Mock Approver Server (for local demo & offline test)
# ------------------------------------------
MOCK_SERVER_PORT=4321
MOCK_SERVER_HOST=127.0.0.1
